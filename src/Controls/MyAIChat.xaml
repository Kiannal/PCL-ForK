<UserControl x:Class="MyAIChat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <local:MyScrollViewer x:Name="PanChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PanChat" />
        </local:MyScrollViewer>
        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <local:MyButton x:Name="BtnSend" DockPanel.Dock="Right" Text="发送" Height="34" MinWidth="90" Padding="18,0" Margin="8,0,0,0" ColorType="Highlight" />
            <local:MyButton x:Name="BtnClear" DockPanel.Dock="Right" Text="清空" Height="34" MinWidth="70" Padding="14,0" Margin="8,0,0,0" />
            <local:MyTextBox x:Name="TextInput" Height="34" VerticalContentAlignment="Center" HintText="输入消息，或输入「打开皮肤库」「打开种子地图」……" />
        </DockPanel>
    </Grid>
</UserControl>
