<Border x:Class="MyButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FocusVisualStyle="{x:Null}" x:Name="PanBack"
             Focusable="True" UseLayoutRounding="False" SnapsToDevicePixels="False" Background="{StaticResource ColorBrushSemiTransparent}">
    <Grid>
        <Border CornerRadius="8" x:Name="PanFore" BorderThickness="1" BorderBrush="{DynamicResource ColorBrush1}" RenderTransformOrigin="0.5,0.5" Background="{StaticResource ColorBrushHalfWhite}">
            <Border.RenderTransform>
                <ScaleTransform />
            </Border.RenderTransform>
            <TextBlock TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True" TextTrimming="None" HorizontalAlignment="Center" x:Name="LabText" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Foreground="{Binding Parent.BorderBrush, RelativeSource={RelativeSource Self}}" FontSize="14" IsHitTestVisible="False">
                <TextBlock.RenderTransform>
                    <ScaleTransform />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Border>
        <Border x:Name="FocusRing" CornerRadius="{Binding CornerRadius, ElementName=PanFore}" BorderThickness="2" Margin="-3"
                BorderBrush="{DynamicResource ColorBrush2}" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</Border>
