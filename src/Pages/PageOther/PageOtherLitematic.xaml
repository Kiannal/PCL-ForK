<local:MyPageRight
    x:Class="PageOtherLitematic"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL">

    <Grid Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <local:MyCard Margin="0,10,0,15" Title="投影查看">
            <StackPanel Margin="22,44,22,16">
                <WrapPanel>
                    <local:MyButton x:Name="BtnChoose" Text="选择投影文件" MinWidth="140" Padding="13,0" Margin="0,0,14,0" ColorType="Highlight" />
                    <local:MyButton x:Name="BtnReload" Text="重新载入" MinWidth="110" Padding="13,0" Margin="0,0,14,0" />
                    <local:MyButton x:Name="BtnResetView" Text="复位视角" MinWidth="110" Padding="13,0" Margin="0,0,14,0" />
                </WrapPanel>
                <TextBlock x:Name="LabFile" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource ColorBrushGray3}" Text="请选择 .litematic 投影文件（Litematica 模组导出的投影）" />
                <TextBlock x:Name="LabInfo" Margin="0,8,0,0" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource ColorBrushGray2}" />
            </StackPanel>
        </local:MyCard>

        <local:MyCard Grid.Row="1" Margin="0,0,0,15" Title="投影库">
            <StackPanel Margin="18,44,18,12">
                <DockPanel Margin="0,0,0,8">
                    <local:MyButton x:Name="BtnLibFold" DockPanel.Dock="Right" Text="折叠" Height="26" Padding="12,0" />
                    <TextBlock x:Name="LabLibStatus" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource ColorBrushGray3}" Text="正在加载在线投影库……" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Grid x:Name="PanLibraryBody">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <local:MyTextBox x:Name="TextLibSearch" Width="170" Height="30" HintText="搜索名称" Margin="0,0,8,0" />
                        <local:MyComboBox x:Name="ComboLibSort" Width="104" Height="30" Margin="0,0,8,0">
                            <local:MyComboBoxItem Content="按名称" Tag="name" IsSelected="True" />
                            <local:MyComboBoxItem Content="按大小" Tag="size" />
                            <local:MyComboBoxItem Content="按来源" Tag="repo" />
                        </local:MyComboBox>
                        <local:MyButton x:Name="BtnLibSearch" Text="搜索" Height="30" Padding="14,0" Margin="0,0,8,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnLibRefresh" Text="刷新" Width="70" Height="30" Padding="14,0" Margin="0,0,8,0" />
                    </DockPanel>
                    <local:MyScrollViewer Grid.Row="1" x:Name="PanLibraryScroller" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanLibrary" />
                    </local:MyScrollViewer>
                </Grid>
            </StackPanel>
        </local:MyCard>

        <local:MyCard Grid.Row="2" Margin="0,0,0,2" Title="3D 预览" VerticalAlignment="Stretch">
            <Grid Margin="14,44,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border ClipToBounds="True" Background="{DynamicResource ColorBrushCard}" BorderThickness="1"
                        BorderBrush="{DynamicResource ColorBrushGray6}" CornerRadius="8">
                    <Grid x:Name="PanViewport" ClipToBounds="True" Background="{DynamicResource ColorBrushCard}">
                        <Viewport3D x:Name="Viewport" ClipToBounds="True" IsHitTestVisible="True" />
                        <TextBlock x:Name="LabEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                                   Foreground="{DynamicResource ColorBrushGray3}" Text="还没有加载投影文件" IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock Text="显示层：" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrushGray3}" />
                    <local:MyComboBox x:Name="ComboLayer" Width="104" Height="26" Margin="4,0,12,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabStatus" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource ColorBrushGray3}" Text="左键拖拽旋转 · 滚轮缩放" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Grid>
        </local:MyCard>
    </Grid>
</local:MyPageRight>
