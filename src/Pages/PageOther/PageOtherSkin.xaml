<local:MyPageRight
    x:Class="PageOtherSkin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    PanScroll="PanBack">

    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10">
            <local:MyCard x:Name="CardOnline" Title="在线皮肤库（LittleSkin）" Margin="0,15,0,15">
                <StackPanel Margin="22,44,22,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <local:MyComboBox x:Name="ComboOnlineSort" Height="30" Width="140" Margin="0,0,12,0">
                            <local:MyComboBoxItem Content="最新上传" Tag="new" IsSelected="True" />
                            <local:MyComboBoxItem Content="最多点赞" Tag="likes" />
                        </local:MyComboBox>
                        <local:MyButton Grid.Column="1" x:Name="BtnOnlinePrev" Text="上一页" MinWidth="90" Padding="13,0" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2" x:Name="LabOnlinePage" VerticalAlignment="Center" Margin="0,0,10,0" Text="第 1 页" />
                        <local:MyButton Grid.Column="3" x:Name="BtnOnlineNext" Text="下一页" MinWidth="90" Padding="13,0" Margin="0,0,10,0" />
                        <local:MyButton Grid.Column="4" x:Name="BtnOnlineRefresh" Text="刷新列表" MinWidth="100" Padding="13,0" Margin="0,0,12,0" />
                        <local:MyButton Grid.Column="5" x:Name="BtnLittleSkin" Text="LittleSkin 登录" MinWidth="130" Padding="13,0" Margin="0,0,12,0" ColorType="Highlight" />
                        <TextBlock Grid.Column="6" x:Name="LabOnlineStatus" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray3}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray3}"
                               Text="来自 LittleSkin 公共皮肤库。点击皮肤卡片会下载到本地皮肤库，然后在下面「本地皮肤库」里选中即可应用。" />
                    <WrapPanel x:Name="PanOnline" Margin="0,12,0,0" />
                </StackPanel>
            </local:MyCard>

                        <local:MyCard x:Name="CardLibrary" Title="本地皮肤库" Margin="0,0,0,15">
                <StackPanel Margin="22,44,22,15">
                    <WrapPanel>
                        <local:MyButton x:Name="BtnRefresh" Text="刷新" MinWidth="100" Padding="13,0" Margin="0,0,14,0" />
                        <local:MyButton x:Name="BtnFetch" Text="从玩家名获取" MinWidth="130" Padding="13,0" Margin="0,0,14,0" />
                        <local:MyButton x:Name="BtnSyncOfficial" Text="同步正版皮肤" MinWidth="130" Padding="13,0" Margin="0,0,14,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnImport" Text="导入本地皮肤" MinWidth="130" Padding="13,0" Margin="0,0,14,0" />
                        <local:MyButton x:Name="BtnApply" Text="应用为离线皮肤" MinWidth="150" Padding="13,0" Margin="0,0,14,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnReset" Text="恢复默认皮肤" MinWidth="130" Padding="13,0" Margin="0,0,14,0" />
                        <local:MyButton x:Name="BtnDelete" Text="删除" MinWidth="90" Padding="13,0" Margin="0,0,14,0" ColorType="Red" />
                        <local:MyButton x:Name="BtnOpenFolder" Text="打开文件夹" MinWidth="110" Padding="13,0" />
                    </WrapPanel>
                    <WrapPanel x:Name="PanSkins" Margin="0,14,0,0" />
                    <TextBlock x:Name="LabEmpty" Margin="0,14,0,0" FontSize="13" Visibility="Collapsed"
                               Foreground="{DynamicResource ColorBrushGray3}" Text="本地皮肤库还是空的，可以在上面点一个在线皮肤，或「从玩家名获取」/「导入本地皮肤」。" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardPreview" Title="预览" Margin="0,0,0,15">
                <Grid Margin="22,44,22,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PanSkinPreview" Background="{DynamicResource ColorBrushCard}" BorderThickness="0" CornerRadius="8" Padding="4">
                        <Viewport3D x:Name="ViewSkin" Width="250" Height="300" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LabName" FontSize="16" FontWeight="Bold" Text="未选择皮肤" />
                        <TextBlock x:Name="LabType" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}" Text="在皮肤库中选择一个皮肤" />
                        <TextBlock x:Name="LabPath" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray3}" />
                        <TextBlock x:Name="LabApplied" Margin="0,6,0,0" FontSize="12" Visibility="Collapsed"
                                   Foreground="{DynamicResource ColorBrush3}" Text="当前正在使用这个皮肤" />
                    </StackPanel>
                </Grid>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
