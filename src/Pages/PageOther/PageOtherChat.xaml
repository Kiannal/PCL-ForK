<local:MyPageRight x:Class="PageOtherChat"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL">
    <Grid Margin="22,14,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <local:MyCard Grid.Row="0" Title="聊天室" Margin="0,0,0,12">
            <StackPanel Margin="20,44,20,14" Orientation="Horizontal">
                <local:MyTextBox x:Name="TextName" IsReadOnly="True" IsReadOnlyCaretVisible="False" Width="150" Height="30" HintText="昵称" Margin="0,0,10,0" />
                <local:MyButton x:Name="BtnRefresh" Height="30" MinWidth="90" Padding="12,0" Margin="0,0,10,0" Text="刷新" />
                <TextBlock x:Name="LabState" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrushGray2}" Text="正在加载……" />
            </StackPanel>
        </local:MyCard>

        <local:MyCard Grid.Row="1" Margin="0,0,0,12">
            <local:MyScrollViewer x:Name="ScrollBox" Margin="16,16,10,16" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanMsgs" Margin="0,0,6,0" />
            </local:MyScrollViewer>
        </local:MyCard>

        <local:MyCard Grid.Row="2">
            <Grid Margin="16,14,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:MyTextBox x:Name="TextInput" Grid.Column="0" Height="34" HintText="说点什么……" Margin="0,0,10,0" />
                <local:MyButton x:Name="BtnSend" Grid.Column="1" Height="34" MinWidth="100" Padding="16,0" Text="发送" ColorType="Highlight" />
            </Grid>
        </local:MyCard>
    </Grid>
</local:MyPageRight>
