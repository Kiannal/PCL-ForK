<local:MyPageRight x:Class="PageOtherTest"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PCL"
    mc:Ignorable="d"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="22,22,22,22">
            <local:MyHint Text="百宝箱：一些零散的小工具，随取随用。" Theme="Blue" Margin="0,0,0,15" />
            <local:MyCard Title="网易中国版" Margin="0,0,0,15">
                <StackPanel Margin="22,44,22,18">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray3}"
                               Text="内置 ES Tool：网易我的世界中国版第三方启动器（登录、联机大厅、184 条命令、下载）。首次使用会释放内置组件到 PCL\NetEase。" />
                    <WrapPanel Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnNeteaseTool" Height="30" MinWidth="140" Padding="13,0" Margin="0,0,10,0" Text="打开网易中国版" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnNeteaseReset" Height="30" MinWidth="140" Padding="13,0" Margin="0,0,10,0" Text="重新释放组件" />
                    </WrapPanel>
                    <TextBlock x:Name="LabNeteaseStatus" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray3}" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="自定义下载" Margin="0,0,0,15">
                <StackPanel Margin="22,44,22,20">
                    <TextBlock Text="输入任意 http/https 直链下载文件，支持多线程与断点续传。" TextWrapping="Wrap" Foreground="{StaticResource ColorBrushGray3}" />
                    <local:MyButton x:Name="BtnCustomDownload" Height="30" MinWidth="120" Text="开始下载" HorizontalAlignment="Left" Margin="0,12,0,0" ColorType="Highlight" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="清理垃圾" Margin="0,0,0,15">
                <StackPanel Margin="22,44,22,20">
                    <TextBlock Text="清理 PCL 的缓存与临时文件，释放磁盘空间。" TextWrapping="Wrap" Foreground="{StaticResource ColorBrushGray3}" />
                    <local:MyButton x:Name="BtnRubbishClear" Height="30" MinWidth="120" Text="扫描并清理" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="内存优化" Margin="0,0,0,15">
                <StackPanel Margin="22,44,22,20">
                    <TextBlock Text="强制回收内存并收缩工作集，缓解 PCL 占用过高。" TextWrapping="Wrap" Foreground="{StaticResource ColorBrushGray3}" />
                    <local:MyButton x:Name="BtnMemoryOptimize" Height="30" MinWidth="120" Text="立即优化" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    <local:MyCheckBox x:Name="CheckRealtimeMemory" Height="20" Margin="0,12,0,0" Text="实时内存优化（自动清理 PCL、Minecraft 与后台占用较高的进程，默认每 30 秒）" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="反作弊与性能" Margin="0,0,0,15">
                <StackPanel Margin="22,44,22,18">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray3}"
                               Text="清理 ACE / SGuard 反作弊残留（会停止相关服务与进程），以及解除 Minecraft 默认 60 帧限制。" />
                    <WrapPanel Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnAceClean" Height="30" MinWidth="140" Padding="13,0" Margin="0,0,10,0" Text="清理 ACE 反作弊" ColorType="Red" />
                        <local:MyButton x:Name="BtnUnlockFps" Height="30" MinWidth="140" Padding="13,0" Margin="0,0,10,0" Text="解除 60 帧限制" ColorType="Highlight" />
                    </WrapPanel>
                    <TextBlock x:Name="LabAceStatus" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray3}" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="小玩意" Margin="0,0,0,15">
                <StackPanel Margin="22,44,22,20">
                    <TextBlock Text="看看今天的人品，或者来一条随机提示。" TextWrapping="Wrap" Foreground="{StaticResource ColorBrushGray3}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnJrrp" Height="30" MinWidth="110" Text="今日人品" Margin="0,0,10,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnRandomHint" Height="30" MinWidth="110" Text="随机提示" Margin="0,0,10,0" />
                        <local:MyButton x:Name="BtnDontClick" Height="30" MinWidth="110" Text="千万别点" ColorType="Red" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
