<local:MyPageRight
    x:Class="PageInstanceTranslate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL">

    <Grid Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <local:MyButton x:Name="BtnScan" Height="30" Padding="14,0,14,0" Margin="0,0,8,0" Text="扫描模组" />
            <local:MyButton x:Name="BtnSelectAll" Grid.Column="1" Height="30" Padding="14,0,14,0" Margin="0,0,8,0" Text="全选" />
            <local:MyButton x:Name="BtnSelectNone" Grid.Column="2" Height="30" Padding="14,0,14,0" Margin="0,0,8,0" Text="全不选" />
            <local:MyButton x:Name="BtnSelectInvert" Grid.Column="3" Height="30" Padding="14,0,14,0" Margin="0,0,8,0" Text="反选" />
            <local:MyButton x:Name="BtnStart" Grid.Column="4" Height="30" Padding="18,0,18,0" Text="开始汉化" ColorType="Highlight" IsEnabled="False" />
                <local:MyButton x:Name="BtnDeepSeek" Grid.Column="5" Height="30" Padding="14,0,14,0" Margin="8,0,0,0" Text="DeepSeek Key" />
        </Grid>

        <TextBlock Grid.Row="1" x:Name="LabHint" Margin="2,0,0,10" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource ColorBrushGray3}"
                   Text="自动把模组的英文语言文件翻译成中文，并生成一个汉化资源包放进 resourcepacks、同时写入 options.txt 自动启用。可以只勾选部分模组，也可以全选一次汉化。首次翻译需要联网（使用免费在线翻译接口）。" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <local:MyCard Title="模组列表" VerticalAlignment="Stretch">
                <Grid Margin="14,44,14,14">
                    <ListBox x:Name="ListMods" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontSize="12.5">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Height" Value="32" />
                                <Setter Property="Padding" Value="4,0,4,0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Display}"
                                          VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource ColorBrush1}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </local:MyCard>

            <local:MyCard Grid.Column="2" Title="汉化日志" VerticalAlignment="Stretch">
                <Grid Margin="14,44,14,14">
                    <TextBox x:Name="TextLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled" Background="White"
                             BorderBrush="{DynamicResource ColorBrushGray6}" Padding="8" Foreground="#282C34" />
                </Grid>
            </local:MyCard>
        </Grid>
    </Grid>
</local:MyPageRight>
